    {
      "parameters": {
        "jsCode": "// Remover quebras de linha e emojis para áudio\nconst textoOriginal = $('Configurações').item.json.mensagem_texto;\nconst nomeContato = $('Loop Contatos').item.json.nome;\n\n// Personalizar mensagem com nome\nlet mensagemPersonalizada = textoOriginal.replace('{{nome}}', nomeContato);\n\n// Limpar texto para áudio\nlet textoLimpo = mensagemPersonalizada\n  .replace(/\\n/g, ' ')\n  .replace(/[\\u{1F600}-\\u{1F64F}]|[\\u{1F300}-\\u{1F5FF}]|[\\u{1F680}-\\u{1F6FF}]|[\\u{1F700}-\\u{1F77F}]|[\\u{1F780}-\\u{1F7FF}]|[\\u{1F800}-\\u{1F8FF}]|[\\u{1F900}-\\u{1F9FF}]|[\\u{1FA00}-\\u{1FA6F}]|[\\u{1FA70}-\\u{1FAFF}]|[\\u{2600}-\\u{26FF}]|[\\u{2700}-\\u{27BF}]/gu, '')\n  .trim();\n\nreturn {\n  mensagem_original: mensagemPersonalizada,\n  texto_para_audio: textoLimpo,\n  nome_contato: nomeContato\n};"
      },
