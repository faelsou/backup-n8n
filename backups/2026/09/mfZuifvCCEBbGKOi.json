      {
        "parameters": {},
        "id": "ec33d8bb-e685-4b87-a191-6c11c93bca07",
        "name": "Merge Items",
        "type": "n8n-nodes-base.merge",
        "position": [
          2880,
          2256
        ],
        "typeVersion": 2
      },
      {
        "parameters": {
          "jsCode": "// Campos injetados pelo nó Config que NÃO fazem parte do workflow\nconst CONFIG_KEYS = ['repo_owner', 'repo_name', 'repo_path', 'subPath'];\n\nconst clean = (obj) => {\n  const copy = { ...obj };\n  CONFIG_KEYS.forEach(k => delete copy[k]);\n  return copy;\n};\n\nconst orderJsonKeys = (obj) => {\n  const ordered = {};\n  Object.keys(obj).sort().forEach(k => { ordered[k] = obj[k]; });\n  return ordered;\n};\n\nconst items = $input.all();\nconst ghItem = items[0].json;                       // resposta do GitHub (ou do Get File)\nconst orderedActual = orderJsonKeys(clean(items[1].json)); // workflow atual no n8n\n\nlet origWorkflow = null;\nif (Object.keys(ghItem).includes('content')) {\n  // Arquivo retornado pela API (base64)\n  origWorkflow = JSON.parse(Buffer.from(ghItem.content, 'base64').toString());\n} else if (Object.keys(ghItem).includes('data')) {\n  // Arquivo grande (>1MB) baixado via download_url\n  origWorkflow = JSON.parse(ghItem.data);\n}\n\nif (origWorkflow) {\n  const orderedOriginal = orderJsonKeys(clean(origWorkflow));\n  if (JSON.stringify(orderedOriginal) === JSON.stringify(orderedActual)) {\n    ghItem.github_status = 'same';\n  } else {\n    ghItem.github_status = 'different';\n    ghItem.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n  }\n  ghItem.content_decoded = orderedOriginal;\n} else {\n  // Arquivo não existe no caminho do mês atual\n  ghItem.github_status = 'new';\n  ghItem.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n}\n\nreturn items;\n"
        },
